{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "book-pinda",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "book.pinda.kr", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "e4b36539-36d0-4863-a8bb-cf71a9151f6c",
      "database_name": "book-pinda",
      "remote": true
    }
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "book-pinda-media", "remote": true }]
}
